{
  "root": "apps/back-office",
  "sourceRoot": "apps/back-office",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/workspace:run-commands",
      "outputs": [
        "dist/apps/back-office"
      ],
      "defaultConfiguration": "production",
      "options": {
        "commands": [
          "next build apps/back-office",
          "node apps/back-office/tools/prepare-dist.js"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "next dev apps/back-office -p 4201"
      },
      "configurations": {
        "production": {
          "command": "next start dist/apps/back-office -p 4201"
        }
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": [
        "coverage/apps/back-office"
      ],
      "options": {
        "jestConfig": "apps/back-office/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/back-office/**/*.{ts,tsx,js,jsx}"
        ]
      }
    }
  },
  "tags": [
    "scope:frontend",
    "type:app"
  ]
}
