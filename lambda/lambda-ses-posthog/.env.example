# Which emails this function takes: prod | dev (dev, UAT and feature envs)
TARGET_ENV=prod
# PostHog host and key are read from SSM <prefix>/POSTHOG_HOST and <prefix>/POSTHOG_API_KEY
POSTHOG_SSM_PREFIX=/prod/directory-service
# Optional overrides of the SSM values
POSTHOG_HOST=
POSTHOG_API_KEY=
# Anything but "false" only logs what would be sent
DRY_RUN=true
# skip | generic (generic sends unrecognised emails as other-email-*)
UNMATCHED_EMAILS=skip
# Comma-separated dev sender addresses; defaults to the dev SES_SOURCE_EMAIL values when unset
DEV_SOURCES=
